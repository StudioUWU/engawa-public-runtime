+#if USE(WINDOWS_EVENT_LOOP) || USE(COCOA_EVENT_LOOP)
+RunLoop::BoundedWorkResult RunLoop::performWorkOnce()
+{
+    bool wasSuppressingFurtherSuspension = m_hasSuspendedFunctions;
+
+    if (m_currentIteration.isEmpty()) {
+        Locker locker { m_nextIterationLock };
+        m_currentIteration = std::exchange(m_nextIteration, { });
+    }
+
+    if (m_currentIteration.isEmpty()) {
+        m_isFunctionDispatchSuspended = false;
+        m_hasSuspendedFunctions = false;
+        return BoundedWorkResult::Empty;
+    }
+
+    if (m_isFunctionDispatchSuspended) {
+        m_isFunctionDispatchSuspended = false;
+        m_hasSuspendedFunctions = true;
+        return BoundedWorkResult::Suspended;
+    }
+
+    auto function = m_currentIteration.takeFirst();
+    function();
+
+    bool didSuspendFunctions = m_isFunctionDispatchSuspended && !m_currentIteration.isEmpty();
+    m_isFunctionDispatchSuspended = false;
+    if (didSuspendFunctions)
+        m_hasSuspendedFunctions = true;
+    else if (m_currentIteration.isEmpty())
+        m_hasSuspendedFunctions = false;
+    else
+        m_hasSuspendedFunctions = wasSuppressingFurtherSuspension;
+
+    if (didSuspendFunctions)
+        return BoundedWorkResult::Suspended;
+    if (!m_currentIteration.isEmpty())
+        return BoundedWorkResult::Remainder;
+    return BoundedWorkResult::Empty;
+}
+#endif
