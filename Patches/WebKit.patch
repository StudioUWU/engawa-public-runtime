+RunLoop::CycleResult RunLoop::cycleOnce()
+{
+    auto& runLoop = currentSingleton();
+    if (runLoop.m_cycleOnceDepth)
+        return CycleResult::Idle;
+    SetForScope cycleDepth {
+        runLoop.m_cycleOnceDepth, runLoop.m_cycleOnceDepth + 1
+    };
+
+    // Claim already-queued functions before entering Core Foundation. The
+    // bounded performWork callback below also covers a concurrent dispatch
+    // which arrives after this check but before the nonblocking source poll.
+    bool hasPendingFunctions = !runLoop.m_currentIteration.isEmpty();
+    if (!hasPendingFunctions) {
+        Locker locker { runLoop.m_nextIterationLock };
+        hasPendingFunctions = !runLoop.m_nextIteration.isEmpty();
+    }
+    if (hasPendingFunctions) {
+        auto result = runLoop.performWorkOnce();
+        if (result == BoundedWorkResult::Remainder
+            || result == BoundedWorkResult::Suspended)
+            runLoop.wakeUp();
+        return CycleResult::Continue;
+    }
+
+    constexpr Seconds maximumTimerWait { 0.001 };
+    TimerBase* nextTimer = nullptr;
+    Seconds nextTimerDelay = maximumTimerWait;
+    {
+        Locker locker { runLoop.m_registeredTimerLock };
+        for (auto* timer : runLoop.m_registeredTimers) {
+            if (!timer->isActive())
+                continue;
+            auto delay = timer->secondsUntilFire();
+            if (delay <= nextTimerDelay) {
+                nextTimer = timer;
+                nextTimerDelay = delay;
+            }
+        }
+    }
+
+    if (nextTimer) {
+        RetainPtr<CFRunLoopTimerRef> timer = nextTimer->m_timer;
+        // Run only the selected WebKit timer in a private mode. Common-mode
+        // timers are deliberately excluded so a turn cannot drain its peers.
+        auto boundedMode = CFSTR("EngawaRuntimeBoundedRunLoopMode");
+        CFRunLoopAddTimer(runLoop.m_runLoop.get(), timer.get(), boundedMode);
+        SetForScope boundedTimerCycle { isRunningBoundedTimerCycle, true };
+        didFireBoundedTimer = false;
+        auto result = CFRunLoopRunInMode(
+            boundedMode, maximumTimerWait.seconds(), false);
+        CFRunLoopRemoveTimer(runLoop.m_runLoop.get(), timer.get(), boundedMode);
+        if (didFireBoundedTimer)
+            return CycleResult::Continue;
+        if (result == kCFRunLoopRunStopped)
+            return CycleResult::Stop;
+    }
+
+    // No queued function or imminent registered timer owns this turn. Poll one
+    // platform source without blocking; performWork remains bounded by depth.
+    auto result = CFRunLoopRunInMode(DefaultRunLoopMode, 0, true);
+    if (result == kCFRunLoopRunStopped)
